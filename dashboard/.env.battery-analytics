# ============================================================================
# Battery Analytics Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------

# Database host (default: localhost for local development)
DB_HOST=localhost

# Database port (default PostgreSQL port)
DB_PORT=5432

# Database name
DB_NAME=supply_chain_iot

# Database user
DB_USER=postgres

# Database password (change this in production!)
DB_PASSWORD=your_secure_password_here

# Connection pool settings (optional)
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECTION_TIMEOUT=2000

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Enable SQL-based battery analytics with Kalman filter, Z-score, and rules
# Set to 'true' to use database, 'false' to use mock data
USE_SQL_BATTERY_ANALYTICS=true

# ----------------------------------------------------------------------------
# Kalman Filter Configuration
# ----------------------------------------------------------------------------

# Process noise covariance (Q)
# Lower values = smoother estimates, slower adaptation
# Higher values = faster adaptation, less smooth
# Recommended: 0.01 for voltage, 0.005 for capacity
KALMAN_PROCESS_NOISE_VOLTAGE=0.01
KALMAN_PROCESS_NOISE_CAPACITY=0.005
KALMAN_PROCESS_NOISE_TEMPERATURE=0.02

# Measurement noise covariance (R)
# Lower values = trust measurements more
# Higher values = trust model more
# Recommended: 0.1 for voltage, 0.05 for capacity
KALMAN_MEASUREMENT_NOISE_VOLTAGE=0.1
KALMAN_MEASUREMENT_NOISE_CAPACITY=0.05
KALMAN_MEASUREMENT_NOISE_TEMPERATURE=0.15

# ----------------------------------------------------------------------------
# Z-Score Analysis Configuration
# ----------------------------------------------------------------------------

# Z-score threshold for anomaly detection
# 2.0 = 95.4% confidence (2 standard deviations)
# 2.5 = 98.8% confidence
# 3.0 = 99.7% confidence (3 standard deviations)
ZSCORE_THRESHOLD=2.0

# Critical Z-score threshold (triggers critical alerts)
ZSCORE_CRITICAL_THRESHOLD=3.0

# Minimum number of historical samples required for Z-score analysis
ZSCORE_MIN_SAMPLES=5

# Historical time window for baseline calculation (in days)
ZSCORE_BASELINE_DAYS=30

# ----------------------------------------------------------------------------
# Alert Rule Configuration
# ----------------------------------------------------------------------------

# Voltage thresholds (in volts)
ALERT_VOLTAGE_CRITICAL_LOW=2.8
ALERT_VOLTAGE_CRITICAL_HIGH=4.2
ALERT_VOLTAGE_WARNING_LOW=3.0
ALERT_VOLTAGE_WARNING_HIGH=4.0

# Capacity thresholds (percentage)
ALERT_CAPACITY_CRITICAL=50
ALERT_CAPACITY_WARNING=70
ALERT_CAPACITY_OPTIMAL=80

# Temperature thresholds (Celsius)
ALERT_TEMPERATURE_WARNING=35
ALERT_TEMPERATURE_CRITICAL=45
ALERT_TEMPERATURE_EXTREME=50

# Charge cycle thresholds
ALERT_CHARGE_CYCLES_HIGH=3000
ALERT_CHARGE_CYCLES_CRITICAL=3500

# ----------------------------------------------------------------------------
# Analytics Configuration
# ----------------------------------------------------------------------------

# Enable/disable specific analytics features
ENABLE_KALMAN_FILTER=true
ENABLE_ZSCORE_ANALYSIS=true
ENABLE_RULE_ENGINE=true

# Default query limit for battery performance queries
BATTERY_QUERY_LIMIT=100

# Time window for recent data queries (in days)
BATTERY_QUERY_WINDOW_DAYS=7

# ----------------------------------------------------------------------------
# Monitoring & Logging
# ----------------------------------------------------------------------------

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed analytics logging
ENABLE_ANALYTICS_LOGGING=false

# Enable performance metrics logging
ENABLE_PERFORMANCE_LOGGING=false

# ----------------------------------------------------------------------------
# API Configuration (if using REST API)
# ----------------------------------------------------------------------------

# API base URL
API_BASE_URL=http://localhost:3000

# API timeout (milliseconds)
API_TIMEOUT=5000

# ----------------------------------------------------------------------------
# Production Settings
# ----------------------------------------------------------------------------

# Environment (development, staging, production)
NODE_ENV=development

# Enable SSL for database connection
# DB_SSL=true

# Database SSL certificate path (if required)
# DB_SSL_CERT_PATH=/path/to/cert.pem

# ----------------------------------------------------------------------------
# Example Production Configuration
# ----------------------------------------------------------------------------
# Uncomment and modify for production use:

# NODE_ENV=production
# DB_HOST=your-production-db-host.com
# DB_NAME=supply_chain_iot_prod
# DB_USER=app_user
# DB_PASSWORD=your_very_secure_password
# DB_SSL=true
# LOG_LEVEL=warn
# ENABLE_ANALYTICS_LOGGING=true
# ENABLE_PERFORMANCE_LOGGING=true

# ----------------------------------------------------------------------------
# TimescaleDB Configuration (Optional)
# ----------------------------------------------------------------------------
# If using TimescaleDB for time-series optimization:

# ENABLE_TIMESCALEDB=true
# TIMESCALEDB_CHUNK_TIME_INTERVAL=7 days
# TIMESCALEDB_COMPRESSION_ENABLED=true
# TIMESCALEDB_RETENTION_DAYS=365

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
